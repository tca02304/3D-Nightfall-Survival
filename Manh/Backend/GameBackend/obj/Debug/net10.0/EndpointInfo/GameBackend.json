{
  "openapi": "3.0.4",
  "info": {
    "title": "GameBackend",
    "version": "1.0"
  },
  "paths": {
    "/api/Inventory/{playerId}": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Inventory/{playerId}/save-test": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveInventoryRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveInventoryRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SaveInventoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Item/getallitem": {
      "get": {
        "tags": [
          "Item"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveInventoryRequest": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaveInventorySlot"
            },
            "nullable": true
          },
          "craftingSlots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaveInventorySlot"
            },
            "nullable": true
          },
          "cursorSlot": {
            "$ref": "#/components/schemas/SaveInventorySlot"
          }
        },
        "additionalProperties": false
      },
      "SaveInventorySlot": {
        "type": "object",
        "properties": {
          "slotIndex": {
            "type": "integer",
            "format": "int32"
          },
          "itemId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Inventory"
    },
    {
      "name": "Item"
    }
  ]
}